---
type Props = {
  name: string;
  tagline: string;
  url: string;
  platform: 'iOS' | 'Web';
  year: string;
  index: number;
};
const { name, tagline, url, platform, year, index } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---
<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  class="group relative block overflow-hidden rounded-2xl border border-line bg-white p-6 md:p-7 transition-all duration-300 hover:border-ink hover:-translate-y-1"
>
  <!-- accent corner -->
  <div
    class="absolute top-0 right-0 h-16 w-16 -translate-y-8 translate-x-8 rounded-full bg-accent opacity-0 blur-2xl transition-opacity duration-500 group-hover:opacity-100"
  ></div>

  <div class="relative flex items-center justify-between text-[10px] text-muted font-mono tracking-widest">
    <span>{num} / PROJECT</span>
    <span class="flex items-center gap-2">
      <span
        class={`inline-block h-1.5 w-1.5 rounded-full ${platform === 'iOS' ? 'bg-ink' : 'bg-muted'}`}
      ></span>
      {platform}
    </span>
  </div>

  <h3 class="relative mt-6 text-2xl md:text-3xl font-bold text-ink tracking-tight">
    {name}
  </h3>
  <p class="relative mt-3 text-sm text-muted leading-relaxed">{tagline}</p>

  <div class="relative mt-8 flex items-center justify-between">
    <span class="font-mono text-[10px] text-muted tracking-widest">
      {year}
    </span>
    <span
      class="flex items-center gap-1 text-xs font-semibold text-ink transition-all duration-300 group-hover:gap-2"
    >
      <span class="opacity-0 group-hover:opacity-100 transition-opacity">
        OPEN
      </span>
      <span class="font-mono">→</span>
    </span>
  </div>
</a>
